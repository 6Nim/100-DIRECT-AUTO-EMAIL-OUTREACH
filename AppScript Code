// ==========================================================

const GEMINI_API_KEY = "YOUR_GEMINI_API_KEY_HERE"; // <-- Yahan apni Gemini API Key paste karein

function runGenuineIssueWorkflow() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  const data = sheet.getDataRange().getValues();

  for (let i = 1; i < data.length; i++) {
    let rawUrl = data[i][0];
    let clientEmail = data[i][1];
    let currentStatus = data[i][3];

    // Clear empty rows ya un rows ko skip karein jin ki email bhej chukay hain
    if (!rawUrl || !clientEmail || currentStatus === "Sent") {
      continue;
    }

    let websiteUrl = cleanUrl(rawUrl);
    if (!websiteUrl) {
      sheet.getRange(i + 1, 3).setValue("Invalid URL Format");
      continue;
    }

    // 1. Clean Brand Name Extract Karein
    let brandName = extractBrandName(websiteUrl);

    Logger.log("Testing website performance for: " + brandName);

    // 2. Audit Hosting Health & Speed
    let audit = auditHostingHealth(websiteUrl);

    // 🛑 2 SECOND PAUSE (Website check ke baad server latency aur API rate limit bachanay ke liye)
    Utilities.sleep(2000);

    // 3. AGAR ISSUE DETECT HUA -> DIRECT EMAIL SEND EXECUTION
    if (audit.hasIssue) {
      sheet.getRange(i + 1, 3).setValue(audit.issueDescription);

      // AI se custom response generate karwayein (passing brandName)
      let emailContent = generateSoftOutreachEmail(brandName, audit.issueDescription);
      
      // Fallback Email Body (Agar Gemini API down ho toh script fail nahi hoga)
      if (!emailContent) {
        emailContent = `Hey Team ${brandName},\n\nI was browsing your website today and noticed it was experiencing some server response lag / performance delay.\n\nAre you currently performing any server maintenance or updates on your hosting environment?\n\nBest regards,`;
      }

      // Subject line mein URL ki jagah Clean Brand Name
      let subject = `Quick question regarding ${brandName}`;
      
      try {
        // DIRECT GMAIL TRANSMISSION (Bina Drafts ke Direct Send)
        MailApp.sendEmail({
          to: clientEmail.toString().trim(),
          subject: subject,
          htmlBody: emailContent.replace(/\n/g, '<br>')
        });

        // Update status to 'Sent' instantly
        sheet.getRange(i + 1, 4).setValue("Sent");
        Logger.log("DIRECT MAIL SENT TO -> " + clientEmail);

        // 🛑 1.5 SECOND PAUSE (Gmail sending limit aur next API hit ko balance rakhney ke liye)
        Utilities.sleep(1500);

      } catch (err) {
        sheet.getRange(i + 1, 4).setValue("Mail Error: " + err.message);
        Logger.log("Mail Send Error: " + err);
      }

    } else {
      sheet.getRange(i + 1, 3).setValue(audit.issueDescription);
      sheet.getRange(i + 1, 4).setValue("No Issue Detected");
      Logger.log("SKIPPED: Fast site.");
    }
  }
}

// Clean messy text into valid web URL
function cleanUrl(text) {
  text = text.toString().trim();
  let match = text.match(/(https?:\/\/[^\s\/]+|www\.[^\s\/]+|[a-zA-Z0-9-]+\.[a-zA-Z]{2,})/);
  if (!match) return null;
  let url = match[0];
  if (!url.startsWith("http://") && !url.startsWith("https://")) {
    url = "https://" + url;
  }
  return url;
}

// Multi-Factor Hosting Audit Engine (Threshold > 0.8s)
function auditHostingHealth(url) {
  let startTime = new Date().getTime();
  
  try {
    let response = UrlFetchApp.fetch(url, { 
      muteHttpExceptions: true,
      followRedirects: false, 
      validateHttpsCertificates: false,
      headers: {
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)'
      }
    });
    
    let endTime = new Date().getTime();
    let loadTime = ((endTime - startTime) / 1000).toFixed(2);
    let statusCode = response.getResponseCode();

    // Check 1: Server errors (HTTP 500, 502, 503)
    if (statusCode >= 500 && statusCode <= 599) {
      return { 
        hasIssue: true, 
        issueDescription: `Server Error HTTP ${statusCode} (Hosting overload)` 
      };
    }

    // Check 2: Server Latency (> 0.8s Limit)
    if (parseFloat(loadTime) > 0.8) {
      return {
        hasIssue: true,
        issueDescription: `Server Latency / High TTFB (${loadTime}s)`
      };
    }

    // Check 3: Unsecure HTTP (Missing Auto Redirect)
    if (url.startsWith("http://") && statusCode !== 301 && statusCode !== 302) {
      return {
        hasIssue: true,
        issueDescription: `Unsecure Redirect Issue (No HTTPS Force)`
      };
    }

    return {
      hasIssue: false,
      issueDescription: `Healthy Setup (Response: ${loadTime}s)`
    };

  } catch (e) {
    return {
      hasIssue: true,
      issueDescription: "Server Timeout / SSL Connection Failure"
    };
  }
}

// AI Generator with strict Brand Name Personalization
function generateSoftOutreachEmail(brandName, issueText) {
  if (!GEMINI_API_KEY || GEMINI_API_KEY === "YOUR_GEMINI_API_KEY_HERE") {
    return null;
  }

  const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${GEMINI_API_KEY}`;
  
  const promptText = `
    Write a short, polite, highly conversational cold email to a business team.
    Brand Name: ${brandName}
    Technical Hosting Issue Found: ${issueText}
    
    Instructions:
    - MUST start EXACTLY with: "Hey Team ${brandName},"
    - Mention politely that while auditing web performance, you noticed their site has server response lag (${issueText}).
    - Ask a natural question: "Are you guys currently undergoing server maintenance or updating your web hosting?"
    - Keep it under 55 words. Friendly and natural tone. Do NOT include full website URLs or referral links in the email body.
  `;

  const payload = { "contents": [{ "parts": [{ "text": promptText }] }] };
  const options = {
    "method": "post",
    "contentType": "application/json",
    "payload": JSON.stringify(payload),
    "muteHttpExceptions": true
  };

  try {
    const res = UrlFetchApp.fetch(apiUrl, options);
    const json = JSON.parse(res.getContentText());
    if (json.candidates && json.candidates[0].content.parts[0].text) {
      return json.candidates[0].content.parts[0].text;
    }
  } catch (err) {
    return null;
  }
  return null;
}

// ---------------------------------------------------------
// YAHAN PASTE HUWA HAI EXTRACT BRAND NAME FUNCTION (SAB SE NEECHE)
// ---------------------------------------------------------
function extractBrandName(url) {
  try {
    let domain = url.replace(/^(?:https?:\/\/)?(?:www\.)?/i, "").split('/')[0];
    let name = domain.split('.')[0];
    return name.charAt(0).toUpperCase() + name.slice(1);
  } catch (e) {
    return "your website";
  }
}
